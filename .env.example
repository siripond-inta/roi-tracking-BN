# Copy to .env and adjust values.

PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=roi_tracking_db
JWT_SECRET=change-me

# ── Used only by docker-compose.yml (see README.md) ──────────────────────
# The mysql/backend containers do NOT use DB_HOST/DB_USER/DB_PASSWORD above
# (those are for running the backend directly with node/nodemon against a
# local MySQL). Docker gets its own root password + dedicated app user below.
MYSQL_ROOT_PASSWORD=change-me
DOCKER_DB_USER=roi_app
DOCKER_DB_PASSWORD=change-me
DOCKER_DB_PORT=3306
DOCKER_BACKEND_PORT=3000
