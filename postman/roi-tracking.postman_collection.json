                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const groups = new Set(pm.response.json().data.map(c => c.category_group));",
                  "pm.test(\"มีครบ 5 กลุ่ม REV/BEN/INV/OPC/ADC\", () => [\"REV\",\"BEN\",\"INV\",\"OPC\",\"ADC\"].forEach(g => pm.expect(groups.has(g)).to.be.true));",
                  "pm.test(\"หมวด BEN มีชื่อหน่วยและอัตรา\", () => pm.response.json().data.filter(c => c.category_group === \"BEN\").forEach(c => pm.expect(c.unit_label).to.be.ok));"
                ]
              }
