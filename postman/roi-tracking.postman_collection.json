{
  "info": {
    "name": "ROI Tracking API",
    "description": "ชุดทดสอบ API ของ ROI Tracking (รันด้วย Postman Collection Runner หรือ `npm run test:postman`)\nต้องเปิด backend ที่ {{baseUrl}} และมีข้อมูลตัวอย่างจาก `npm run db:seed` — ชุดทดสอบสร้างโครงการทดสอบเองและลบทิ้งตอนจบ",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "ownerEmail",
      "value": "nichakan@example.com"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "viewerEmail",
      "value": "viewer@example.com"
    },
    {
      "key": "password",
      "value": "Passw0rd!"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "PM-01 Login (project owner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"ได้ token\", () => pm.expect(body.token).to.be.a(\"string\"));",
                  "pm.test(\"ไม่ส่ง password_hash กลับ\", () => pm.expect(pm.response.text()).to.not.include(\"password_hash\"));",
                  "pm.collectionVariables.set(\"token\", body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "PM-02 Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
